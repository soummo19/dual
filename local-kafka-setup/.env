
COMPOSE_PROJECT_NAME=kafka-dual-cluster-project

#images

ZK_IMAGE=zookeeper:3.9
KAFKA_ZK_IMAGE=apache/kafka:3.9.1
KAFKA_KRAFT_IMAGE=apache/kafka:4.1.0
JDK_IMAGE=eclipse-temurin:21-jdk

ZOOKEEPER_PORT=2181
KAFKA_ZK_SSL_PORT=9094
KAFKA_KRAFT_SSL_PORT=9096

KRAFT_CLUSTER_ID=kraft-cluster-1

KAFKA_SSL_PASSWORD=password

ZK_SERVICE_TOPICS=zk-topic1
KRAFT_SERVICE_TOPICS=kraft-topic1
TOPIC_PARTITIONS=3